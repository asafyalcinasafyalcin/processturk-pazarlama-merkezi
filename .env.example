# ============================================================================
# ProcessTürk Pazarlama Komuta Merkezi — ortam değişkenleri
# Kopyala: cp .env.example .env.local
# .env.local ASLA commit edilmez.
# ============================================================================

# --- Üretim motoru (cap başına override edilebilir) ---
# GEN_PROVIDER: tüm üretimlerin varsayılanı (higgsfield | fal)
GEN_PROVIDER=higgsfield
# Metin (copy/sahne planı) için ayrı sağlayıcı — openai en güvenilir
GEN_TEXT_PROVIDER=openai

# --- Higgsfield CLI (görsel/video/ses/müzik) ---
# Lokalde: npm i -g @higgsfield/cli && higgsfield login  → ~/.config/higgsfield/credentials.json
HIGGSFIELD_BIN=higgsfield
HF_TTS_MODEL=elevenlabs
# Container'da: ~/.config/higgsfield/credentials.json içeriğini buraya tek satır JSON olarak ver
# (lokalde gerekmez; CLI dosyadan okur). Bkz. DEPLOY.md.
HF_CREDENTIALS_JSON=

# --- OpenAI (metin: copy + sahne planı) ---
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini

# --- fal.ai (yedek motor; hesap bakiyesi bitince devre dışı) ---
FAL_KEY=
FAL_LLM_MODEL=openai/gpt-4o-mini

# --- Tek kaynak ürün verisi. Boşsa ../Meta_Reklam_Sistemi/data/products.json; container'da /app/data/products.json ---
PRODUCTS_JSON_PATH=

# --- İçerik ajanı (LinkedIn/X gerçek yayın köprüsü) ---
ICERIK_AJANI_URL=http://127.0.0.1:4173

# --- Acil yayın geçici kilidi (Faz 2'de gerçek RBAC ile değişecek) ---
# /api/quick-publish x-admin-token başlığında bu değeri ister; boşsa uç fail-closed (403).
QUICK_PUBLISH_TOKEN=

# --- Meta Reklam (kampanya kurulumu + IG/FB yayın) ---
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_IG_BUSINESS_ID=
META_API_VERSION=v21.0
WHATSAPP_NUMBER=905527062723
# Meta_Reklam_Sistemi kök yolu (kampanya scriptleri için)
META_REKLAM_PATH=
